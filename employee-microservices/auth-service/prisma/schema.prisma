
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OtpChallenge {
  id        String    @id @default(cuid())
  email     String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([email, createdAt])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}
